@model List<OSAWebAPI.Models.RegionComModel>
@{
    ViewData["Title"] = "Region Communications";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalRecords = (int)(ViewBag.TotalRecords ?? 0);
    var selectedDirection = ViewBag.SelectedDirection ?? "All";
    var selectedYear = ViewBag.SelectedYear;
    var searchTerm = ViewBag.SearchTerm ?? "";
}

<div>
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Region Communications</h1>
        <p class="text-sm text-gray-500 mt-1">@totalRecords record@(totalRecords != 1 ? "s" : "") found</p>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 shadow-sm mb-4 p-4">
        <div class="flex flex-wrap items-end gap-3">
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Year</label>
                <select id="filterYear" onchange="applyFilters()" class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 w-32">
                    <option value="">All Years</option>
                    @foreach (var yr in ViewBag.Years)
                    {
                        @if (selectedYear?.ToString() == yr.ToString())
                        {
                            <option value="@yr" selected>@yr</option>
                        }
                        else
                        {
                            <option value="@yr">@yr</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Direction</label>
                <div class="flex rounded-lg border border-gray-300 overflow-hidden">
                    <button type="button" onclick="setDirection('All')" id="dirAll" class="direction-btn px-4 py-2 text-sm font-medium @(selectedDirection == "All" ? "bg-blue-600 text-white" : "bg-white text-gray-700 hover:bg-gray-100")">All</button>
                    <button type="button" onclick="setDirection('To Region')" id="dirTo" class="direction-btn px-4 py-2 text-sm font-medium border-l border-gray-300 @(selectedDirection == "To Region" ? "bg-green-600 text-white" : "bg-white text-gray-700 hover:bg-gray-100")">To Region</button>
                    <button type="button" onclick="setDirection('From Region')" id="dirFrom" class="direction-btn px-4 py-2 text-sm font-medium border-l border-gray-300 @(selectedDirection == "From Region" ? "bg-purple-600 text-white" : "bg-white text-gray-700 hover:bg-gray-100")">From Region</button>
                </div>
            </div>
            <div class="flex-1 min-w-[200px]">
                <label class="block text-xs font-medium text-gray-600 mb-1">Search</label>
                <div class="relative">
                    <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    <input type="text" id="filterSearch" value="@searchTerm" placeholder="Search subject, ref#, received from, type, date..."
                           class="w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
            </div>
            <div class="flex items-end space-x-2">
                <button onclick="applyFilters()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center space-x-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    <span>Search</span>
                </button>
                <button onclick="resetFilters()" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                    Reset
                </button>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-3 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Date Received</th>
                        <th class="px-3 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Doc Date</th>
                        <th class="px-3 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider w-24">Type</th>
                        <th class="px-3 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider min-w-[300px]">Particulars</th>
                        <th class="px-3 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                            <a href="@BuildSortUrl()" class="flex items-center hover:text-blue-600">
                                Control #
                                @if (ViewBag.CurrentSort == "controlDesc")
                                {
                                    <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                }
                                else
                                {
                                    <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
                                }
                            </a>
                        </th>
                        <th class="px-3 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Received From</th>
                        <th class="px-3 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Direction</th>
                        <th class="px-3 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Remarks</th>
                        <th class="px-3 py-3 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider w-16">PDF</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-blue-50 cursor-pointer transition-colors" onclick="window.location='/RegionCom/Details/@item.Id'">
                                <td class="px-3 py-3 whitespace-nowrap text-sm text-gray-900">
                                    @(item.DateReceived?.ToString("MM-dd-yyyy") ?? "N/A")
                                </td>
                                <td class="px-3 py-3 whitespace-nowrap text-sm text-gray-900">
                                    @(item.DocumentDate?.ToString("MM-dd-yyyy") ?? "N/A")
                                </td>
                                <td class="px-3 py-3 whitespace-nowrap text-sm max-w-[100px] truncate">
                                    <span class="px-2 py-0.5 bg-gray-100 text-gray-700 rounded text-xs">@item.TypeOfDocs</span>
                                </td>
                                <td class="px-3 py-3 text-sm text-gray-900 max-w-[400px] truncate" title="@item.SubjectParticulars">
                                    @item.SubjectParticulars
                                </td>
                                <td class="px-3 py-3 whitespace-nowrap text-sm">
                                    @if (!string.IsNullOrEmpty(item.RefNumber))
                                    {
                                        <span class="px-2 py-0.5 bg-blue-100 text-blue-800 rounded text-xs font-semibold">@item.RefNumber</span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 text-xs">-</span>
                                    }
                                </td>
                                <td class="px-3 py-3 whitespace-nowrap text-sm text-gray-700 max-w-[150px] truncate" title="@item.ReceivedFrom">
                                    @(item.ReceivedFrom ?? "-")
                                </td>
                                <td class="px-3 py-3 whitespace-nowrap text-sm">
                                    @if (item.Direction == "To Region")
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800">
                                            To Region
                                        </span>
                                    }
                                    else if (item.Direction == "From Region")
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-800">
                                            From Region
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 text-xs">@item.Direction</span>
                                    }
                                </td>
                                <td class="px-3 py-3 text-sm text-gray-600 max-w-[200px] truncate" title="@item.Remarks">
                                    @(item.Remarks ?? "-")
                                </td>
                                <td class="px-3 py-3 whitespace-nowrap text-sm text-center">
                                    @if (!string.IsNullOrEmpty(item.ScannedCopy))
                                    {
                                        <a href="@item.ScannedCopy" target="_blank" class="inline-flex items-center justify-center text-blue-600 hover:text-blue-800" title="Open PDF" onclick="event.stopPropagation();">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                            </svg>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-gray-300">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="px-6 py-12 text-center">
                                <div class="text-center">
                                    <svg class="w-12 h-12 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                    </svg>
                                    <p class="text-lg font-medium text-gray-500">No records found</p>
                                    <p class="text-sm text-gray-400 mt-1">Try adjusting your search filters</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="flex items-center justify-between px-4 py-3 border-t border-gray-200 bg-gray-50">
                <div class="text-sm text-gray-600">
                    Showing @((currentPage - 1) * 25 + 1) to @Math.Min(currentPage * 25, totalRecords) of @totalRecords
                </div>
                <div class="flex space-x-1">
                    @if (currentPage > 1)
                    {
                        <a href="@BuildPageUrl(1)" class="px-3 py-1 text-sm bg-white border border-gray-300 rounded-md hover:bg-gray-50 text-gray-700">First</a>
                        <a href="@BuildPageUrl(currentPage - 1)" class="px-3 py-1 text-sm bg-white border border-gray-300 rounded-md hover:bg-gray-50 text-gray-700">Prev</a>
                    }
                    @{
                        int startPage = Math.Max(1, currentPage - 2);
                        int endPage = Math.Min(totalPages, currentPage + 2);
                    }
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        if (i == currentPage)
                        {
                            <span class="px-3 py-1 text-sm bg-blue-600 text-white rounded-md font-medium">@i</span>
                        }
                        else
                        {
                            <a href="@BuildPageUrl(i)" class="px-3 py-1 text-sm bg-white border border-gray-300 rounded-md hover:bg-gray-50 text-gray-700">@i</a>
                        }
                    }
                    @if (currentPage < totalPages)
                    {
                        <a href="@BuildPageUrl(currentPage + 1)" class="px-3 py-1 text-sm bg-white border border-gray-300 rounded-md hover:bg-gray-50 text-gray-700">Next</a>
                        <a href="@BuildPageUrl(totalPages)" class="px-3 py-1 text-sm bg-white border border-gray-300 rounded-md hover:bg-gray-50 text-gray-700">Last</a>
                    }
                </div>
            </div>
        }
    </div>
</div>

@functions {
    private string BuildPageUrl(int page)
    {
        var queryParams = new List<string>();
        if (ViewBag.SelectedYear != null) queryParams.Add($"year={ViewBag.SelectedYear}");
        if (!string.IsNullOrEmpty(ViewBag.SelectedDirection?.ToString()) && ViewBag.SelectedDirection?.ToString() != "All")
            queryParams.Add($"direction={ViewBag.SelectedDirection}");
        if (!string.IsNullOrEmpty(ViewBag.SearchTerm?.ToString())) queryParams.Add($"search={ViewBag.SearchTerm}");
        if (ViewBag.CurrentSort?.ToString() == "controlAsc") queryParams.Add("sort=controlAsc");
        queryParams.Add($"page={page}");
        return "/RegionCom?" + string.Join("&", queryParams);
    }

    private string BuildSortUrl()
    {
        var queryParams = new List<string>();
        if (ViewBag.SelectedYear != null) queryParams.Add($"year={ViewBag.SelectedYear}");
        if (!string.IsNullOrEmpty(ViewBag.SelectedDirection?.ToString()) && ViewBag.SelectedDirection?.ToString() != "All")
            queryParams.Add($"direction={ViewBag.SelectedDirection}");
        if (!string.IsNullOrEmpty(ViewBag.SearchTerm?.ToString())) queryParams.Add($"search={ViewBag.SearchTerm}");
        if (ViewBag.CurrentSort?.ToString() == "controlDesc")
            queryParams.Add("sort=controlAsc");
        else
            queryParams.Add("sort=controlDesc");
        return "/RegionCom?" + string.Join("&", queryParams);
    }
}

@section Scripts {
<script>
var currentDirection = '@(selectedDirection)';

function setDirection(dir) {
    currentDirection = dir;
    document.querySelectorAll('.direction-btn').forEach(function(btn) {
        btn.classList.remove('bg-blue-600', 'text-white', 'bg-green-600', 'bg-purple-600');
        btn.classList.add('bg-white', 'text-gray-700', 'hover:bg-gray-100');
    });
    if (dir === 'All') {
        var btn = document.getElementById('dirAll');
        btn.classList.remove('bg-white', 'text-gray-700', 'hover:bg-gray-100');
        btn.classList.add('bg-blue-600', 'text-white');
    } else if (dir === 'To Region') {
        var btn = document.getElementById('dirTo');
        btn.classList.remove('bg-white', 'text-gray-700', 'hover:bg-gray-100');
        btn.classList.add('bg-green-600', 'text-white');
    } else if (dir === 'From Region') {
        var btn = document.getElementById('dirFrom');
        btn.classList.remove('bg-white', 'text-gray-700', 'hover:bg-gray-100');
        btn.classList.add('bg-purple-600', 'text-white');
    }
    applyFilters();
}

function applyFilters() {
    var params = new URLSearchParams();
    var year = document.getElementById('filterYear').value;
    var search = document.getElementById('filterSearch').value;
    if (year) params.append('year', year);
    if (currentDirection && currentDirection !== 'All') params.append('direction', currentDirection);
    if (search) params.append('search', search);
    window.location.href = '/RegionCom?' + params.toString();
}

function resetFilters() {
    window.location.href = '/RegionCom';
}

document.getElementById('filterSearch').addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
        applyFilters();
    }
});
</script>
}