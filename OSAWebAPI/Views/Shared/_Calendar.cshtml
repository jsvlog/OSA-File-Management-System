<div x-data="calendarModal()" x-cloak>
    <button @@click="open = true" 
            class="relative p-3 bg-white dark:bg-gray-800 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-200 dark:border-gray-700 group">
        <svg class="w-6 h-6 text-blue-600 dark:text-blue-400 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <span x-show="eventsCount > 0" 
              class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs font-bold rounded-full flex items-center justify-center"
              x-text="eventsCount"></span>
    </button>

    <div x-show="open" 
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 translate-y-4"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 translate-y-4"
         x-cloak
         class="fixed inset-0 z-50 flex items-center justify-center p-4"
         style="display: none;">
        <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" @@click="open = false"></div>
        
        <div class="relative bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-4xl max-h-[90vh] overflow-hidden"
             @@click.outside="open = false">
            <div class="bg-gradient-to-r from-blue-600 to-purple-600 px-6 py-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-4">
                        <button @@click="prevMonth()" 
                                class="p-2 hover:bg-white/20 rounded-lg transition-colors"
                                aria-label="Previous month">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                            </svg>
                        </button>
                        <h2 class="text-xl font-bold text-white min-w-[200px] text-center" x-text="monthYear"></h2>
                        <button @@click="nextMonth()" 
                                class="p-2 hover:bg-white/20 rounded-lg transition-colors"
                                aria-label="Next month">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </button>
                    </div>
                    <div class="flex items-center space-x-3">
                        <button @@click="goToToday()" 
                                class="px-4 py-2 bg-white/20 hover:bg-white/30 text-white rounded-lg text-sm font-medium transition-colors">
                            Today
                        </button>
                        <button @@click="open = false" 
                                class="p-2 hover:bg-white/20 rounded-lg transition-colors"
                                aria-label="Close calendar">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <div class="flex flex-col md:flex-row h-[calc(90vh-64px)]">
                <div class="flex-1 p-4 overflow-auto">
                    <div class="grid grid-cols-7 gap-1 mb-2">
                        <template x-for="day in ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']" :key="day">
                            <div class="text-center text-sm font-semibold text-gray-500 dark:text-gray-400 py-2" x-text="day"></div>
                        </template>
                    </div>
                    <div class="grid grid-cols-7 gap-1">
                        <template x-for="date in calendarDates" :key="date.key">
                            <div @@click="selectDate(date)"
                                 class="aspect-square flex flex-col items-center justify-center rounded-lg cursor-pointer transition-all duration-200 relative"
                                 :class="{
                                    'hover:bg-blue-50 dark:hover:bg-gray-700': !date.isToday,
                                    'bg-gradient-to-r from-blue-500 to-purple-500 text-white': date.isToday,
                                    'text-gray-400 dark:text-gray-600': !date.inCurrentMonth,
                                    'text-gray-900 dark:text-white': date.inCurrentMonth && !date.isToday,
                                    'ring-2 ring-blue-400 dark:ring-blue-500': isSelected(date.date)
                                 }">
                                <span class="text-sm font-medium" x-text="date.day"></span>
                                <div x-show="date.events > 0" 
                                     class="absolute bottom-1 flex space-x-0.5">
                                    <template x-for="i in Math.min(date.events, 3)" :key="i">
                                        <span class="w-1.5 h-1.5 bg-blue-500 rounded-full"></span>
                                    </template>
                                    <span x-show="date.events > 3" 
                                          class="text-xs text-gray-500 dark:text-gray-400"
                                          x-text="'+' + (date.events - 3)"></span>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>

                <div x-show="selectedDate" 
                     x-transition:enter="transition ease-out duration-300"
                     x-transition:enter-start="opacity-0 translate-x-4"
                     x-transition:enter-end="opacity-100 translate-x-0"
                     class="w-full md:w-80 border-l border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50 p-4 overflow-auto"
                     style="display: none;">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white" x-text="selectedDateFormatted"></h3>
                        <button @@click="selectedDate = null" 
                                class="p-1 hover:bg-gray-200 dark:hover:bg-gray-700 rounded transition-colors">
                            <svg class="w-4 h-4 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                    
                    <div x-show="dayEvents.length === 0" class="text-center py-12">
                        <svg class="w-16 h-16 mx-auto text-gray-300 dark:text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        <p class="text-gray-500 dark:text-gray-400">No activities scheduled</p>
                    </div>

                    <div class="space-y-3">
                        <template x-for="event in dayEvents" :key="event.id">
                            <div class="bg-white dark:bg-gray-800 rounded-xl p-4 shadow-sm border border-gray-200 dark:border-gray-700">
                                <div class="flex items-start space-x-3">
                                    <div class="flex-shrink-0 w-12 text-center">
                                        <div class="text-xs text-gray-500 dark:text-gray-400" x-text="event.time"></div>
                                    </div>
                                    <div class="flex-1">
                                        <h4 class="font-semibold text-gray-900 dark:text-white text-sm" x-text="event.title"></h4>
                                        <p x-show="event.description" class="text-sm text-gray-600 dark:text-gray-400 mt-1" x-text="event.description"></p>
                                        <div x-show="event.type" class="mt-2">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium"
                                                  :class="{
                                                    'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200': event.type === 'meeting',
                                                    'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200': event.type === 'deadline',
                                                    'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200': event.type === 'review',
                                                    'bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-200': event.type === 'audit'
                                                  }"
                                                  x-text="event.type || 'activity'"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function calendarModal() {
    return {
        open: false,
        currentDate: new Date(),
        selectedDate: null,
        eventsCount: 3,
        events: [
            { id: 1, date: new Date(new Date().setDate(5)), title: 'Financial Review Meeting', time: '09:00 AM', type: 'meeting', description: 'Quarterly financial statement review' },
            { id: 2, date: new Date(new Date().setDate(12)), title: 'AOM Deadline', time: '05:00 PM', type: 'deadline', description: 'Submit acknowledgment of memorandum' },
            { id: 3, date: new Date(new Date().setDate(15)), title: 'Barangay Audit', time: '10:00 AM', type: 'audit', description: 'Annual barangay financial audit' },
            { id: 4, date: new Date(new Date().setDate(20)), title: 'AAR Review', time: '02:00 PM', type: 'review', description: 'Review annual audit reports' },
            { id: 5, date: new Date(new Date().setDate(25)), title: 'Municipal Audit', time: '09:00 AM', type: 'audit', description: 'Annual municipal audit review' }
        ],
        
        get monthYear() {
            const months = ['January', 'February', 'March', 'April', 'May', 'June', 
                         'July', 'August', 'September', 'October', 'November', 'December'];
            return `${months[this.currentDate.getMonth()]} ${this.currentDate.getFullYear()}`;
        },
        
        get calendarDates() {
            const year = this.currentDate.getFullYear();
            const month = this.currentDate.getMonth();
            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const today = new Date();
            
            const dates = [];
            const prevMonthDays = new Date(year, month, 0).getDate();
            
            for (let i = firstDay - 1; i >= 0; i--) {
                dates.push({
                    day: prevMonthDays - i,
                    date: new Date(year, month - 1, prevMonthDays - i),
                    inCurrentMonth: false,
                    isToday: false,
                    key: `prev-${i}`,
                    events: this.getEventsForDate(new Date(year, month - 1, prevMonthDays - i))
                });
            }
            
            for (let i = 1; i <= daysInMonth; i++) {
                const date = new Date(year, month, i);
                dates.push({
                    day: i,
                    date: date,
                    inCurrentMonth: true,
                    isToday: date.toDateString() === today.toDateString(),
                    key: i,
                    events: this.getEventsForDate(date)
                });
            }
            
            const remainingDays = 42 - dates.length;
            for (let i = 1; i <= remainingDays; i++) {
                dates.push({
                    day: i,
                    date: new Date(year, month + 1, i),
                    inCurrentMonth: false,
                    isToday: false,
                    key: `next-${i}`,
                    events: this.getEventsForDate(new Date(year, month + 1, i))
                });
            }
            
            return dates;
        },
        
        get selectedDateFormatted() {
            if (!this.selectedDate) return '';
            const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 
                         'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
            return `${this.selectedDate.getDate()} ${months[this.selectedDate.getMonth()]} ${this.selectedDate.getFullYear()}`;
        },
        
        get dayEvents() {
            if (!this.selectedDate) return [];
            return this.events.filter(e => 
                e.date.toDateString() === this.selectedDate.toDateString()
            );
        },
        
        getEventsForDate(date) {
            return this.events.filter(e => e.date.toDateString() === date.toDateString()).length;
        },
        
        isSelected(date) {
            return this.selectedDate && date.toDateString() === this.selectedDate.toDateString();
        },
        
        selectDate(date) {
            if (date.inCurrentMonth) {
                this.selectedDate = date;
            }
        },
        
        prevMonth() {
            this.currentDate = new Date(this.currentDate.getFullYear(), this.currentDate.getMonth() - 1, 1);
        },
        
        nextMonth() {
            this.currentDate = new Date(this.currentDate.getFullYear(), this.currentDate.getMonth() + 1, 1);
        },
        
        goToToday() {
            this.currentDate = new Date();
            this.selectedDate = new Date();
        }
    };
}
</script>
