@model List<OSAWebAPI.Models.VisitorLog>
@{
    ViewData["Title"] = "Visitor Logs";
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Visitor Logs</h1>
    <span class="text-sm text-gray-500">Read-only view</span>
</div>

<div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-6">
    <div class="p-4">
        <form method="get" asp-action="Index" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-4">
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Search</label>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Name or purpose..."
                       class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Office</label>
                <input type="text" name="office" value="@ViewBag.Office" placeholder="Office..."
                       class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Municipality</label>
                <input type="text" name="municipality" value="@ViewBag.Municipality" placeholder="Municipality..."
                       class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Barangay</label>
                <input type="text" name="barangay" value="@ViewBag.Barangay" placeholder="Barangay..."
                       class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Date From</label>
                <input type="date" name="dateFrom" value="@ViewBag.DateFrom"
                       class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 mb-1">Date To</label>
                <input type="date" name="dateTo" value="@ViewBag.DateTo"
                       class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="md:col-span-3 lg:col-span-6 flex justify-end space-x-2">
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700 transition-colors">
                    Search
                </button>
                <a href="/Visitors" class="px-4 py-2 bg-gray-200 text-gray-700 text-sm rounded-md hover:bg-gray-300 transition-colors">
                    Clear
                </a>
            </div>
        </form>
    </div>
</div>

<div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Purpose</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Office</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Municipality</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Barangay</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Entry Time</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="px-4 py-8 text-center text-gray-500">No visitor logs found.</td>
                    </tr>
                }
                else
                {
                    foreach (var log in Model)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-3 text-sm text-gray-900">@log.Name</td>
                            <td class="px-4 py-3 text-sm text-gray-600">@log.Purpose</td>
                            <td class="px-4 py-3 text-sm text-gray-600">@log.Office</td>
                            <td class="px-4 py-3 text-sm text-gray-600">@log.Municipality</td>
                            <td class="px-4 py-3 text-sm text-gray-600">@log.Barangay</td>
                            <td class="px-4 py-3 text-sm text-gray-600">@(log.EntryTime?.ToString("g") ?? "-")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
