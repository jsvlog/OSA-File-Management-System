@model OSAWebAPI.Models.MonitoringStatusGrid
@{
    ViewData["Title"] = ViewBag.DocumentType + " - Monitoring Status";
    var years = ViewBag.Years as List<int>;
    var selectedYear = (int)ViewBag.SelectedYear;
    var municipalities = ViewBag.Municipalities as List<string>;
    string docType = ViewBag.DocumentType;
    var docTypeDisplayNames = new Dictionary<string, string>
    {
        { "Financial Statement", "Financial Statement" },
        { "Barangay Financial Statement", "Barangay Financial Statement" },
        { "AOM", "Audit Observation Memorandum" },
        { "Barangay AOM", "Barangay Audit Observation Memorandum" },
        { "AAR", "Annual Audit Report" },
        { "Barangay AAR", "Barangay AAR" }
    };
}

<div>
    <div class="mb-6">
        <a href="/Monitoring" class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors text-sm font-medium">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Back to Monitoring
        </a>
    </div>

    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">@(docTypeDisplayNames.ContainsKey(docType) ? docTypeDisplayNames[docType] : docType)</h1>
            <p class="text-sm text-gray-500 mt-1">Annual submission status by municipality</p>
        </div>
        <div class="flex items-center space-x-2">
            <label class="text-sm font-medium text-gray-600">Year:</label>
            <select id="yearSelect" onchange="changeYear()" class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                @foreach (var yr in years ?? new List<int>())
                {
                    @if (yr == selectedYear)
                    {
                        <option value="@yr" selected>@yr</option>
                    }
                    else
                    {
                        <option value="@yr">@yr</option>
                    }
                }
            </select>
        </div>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider min-w-[180px]">Municipality</th>
                        <th class="px-4 py-3 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider min-w-[120px]">Status</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider min-w-[150px]">Date Submitted</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Remarks</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @if (Model.Municipalities.Any())
                    {
                        @foreach (var muni in Model.Municipalities)
                        {
                            var statusBgClass = "";
                            var statusTextClass = "";
                            var statusLabel = "";
                            if (muni.Status == "Submitted")
                            {
                                statusBgClass = "bg-green-100";
                                statusTextClass = "text-green-700";
                                statusLabel = "Submitted";
                            }
                            else if (muni.Status == "Pending")
                            {
                                statusBgClass = "bg-yellow-100";
                                statusTextClass = "text-yellow-700";
                                statusLabel = "Pending";
                            }
                            else
                            {
                                statusBgClass = "bg-gray-100";
                                statusTextClass = "text-gray-500";
                                statusLabel = "Not Submitted";
                            }

                            <tr class="hover:bg-gray-50">
                                <td class="px-4 py-3 text-sm font-medium text-gray-900">
                                    @muni.Municipality
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @statusBgClass @statusTextClass">
                                        @if (muni.Status == "Submitted")
                                        {
                                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                            </svg>
                                        }
                                        else if (muni.Status == "Pending")
                                        {
                                            <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-yellow-500"></span>
                                        }
                                        @statusLabel
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-sm text-gray-600">
                                    @(muni.DateSubmitted.HasValue ? muni.DateSubmitted.Value.ToString("MM/dd/yyyy") : "—")
                                </td>
                                <td class="px-4 py-3 text-sm text-gray-600">
                                    @(muni.Remarks ?? "—")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center">
                                <p class="text-gray-500">No municipalities found. Add municipalities in the Region Com records first.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4 flex items-center space-x-6 text-sm text-gray-600">
        <div class="flex items-center space-x-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-green-100">
                <svg class="w-3 h-3 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
            </span>
            <span>Submitted</span>
        </div>
        <div class="flex items-center space-x-2">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-yellow-100">
                <span class="text-yellow-600 text-xs font-bold">&#8226;</span>
            </span>
            <span>Pending</span>
        </div>
        <div class="flex items-center space-x-2">
            <span class="text-gray-300">&ndash;</span>
            <span>Not Submitted</span>
        </div>
    </div>
</div>

@section Scripts {
<script>
function changeYear() {
    const year = document.getElementById('yearSelect').value;
    const docType = '@Uri.EscapeDataString(docType)';
    window.location.href = '/Monitoring/Status?docType=' + docType + '&year=' + year;
}
</script>
}