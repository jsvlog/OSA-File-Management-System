@model OSAWebAPI.Models.InventoryModel
@{
    ViewData["Title"] = "Inventory Details";
}

<div>
    <div class="mb-6">
        <a href="/Inventory" class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors text-sm font-medium">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Back to Inventory
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Item Details</h2>
            <div class="space-y-4">
                <div class="bg-gray-50 rounded-lg p-4">
                    <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Date</label>
                    <p class="text-gray-900 font-medium">@(Model.Date?.ToString("MMMM dd, yyyy") ?? "N/A")</p>
                </div>
                <div class="bg-gray-50 rounded-lg p-4">
                    <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Type</label>
                    <p class="text-gray-900 font-medium">@Model.Type</p>
                </div>
                <div class="bg-gray-50 rounded-lg p-4">
                    <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Description</label>
                    <p class="text-gray-900 whitespace-pre-wrap">@(Model.Description ?? "N/A")</p>
                </div>
                <div class="bg-gray-50 rounded-lg p-4">
                    <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Status</label>
                    @{
                        var statusClass = "bg-gray-100 text-gray-700";
                        if (Model.Status?.ToLower().Contains("complete") == true || Model.Status?.ToLower().Contains("done") == true)
                            statusClass = "bg-green-100 text-green-800";
                        else if (Model.Status?.ToLower().Contains("pending") == true || Model.Status?.ToLower().Contains("ongoing") == true)
                            statusClass = "bg-yellow-100 text-yellow-800";
                        else if (Model.Status?.ToLower().Contains("missing") == true || Model.Status?.ToLower().Contains("lost") == true)
                            statusClass = "bg-red-100 text-red-800";
                    }
                    <span class="px-3 py-1 rounded-full text-sm font-medium @statusClass">@Model.Status</span>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Additional Information</h2>
                <div class="space-y-4">
                    <div class="bg-gray-50 rounded-lg p-4">
                        <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Location</label>
                        <p class="text-gray-900 font-medium">@(Model.Location ?? "N/A")</p>
                    </div>
                    <div class="bg-gray-50 rounded-lg p-4">
                        <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Remarks</label>
                        <p class="text-gray-900 whitespace-pre-wrap">@(Model.Remarks ?? "N/A")</p>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ScannedCopy))
            {
                <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
                    <h2 class="text-lg font-semibold text-gray-900 mb-4">Scanned Copy</h2>
                    <a href="@Model.ScannedCopy" target="_blank" class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        Open PDF
                    </a>
                </div>
            }
        </div>
    </div>
</div>