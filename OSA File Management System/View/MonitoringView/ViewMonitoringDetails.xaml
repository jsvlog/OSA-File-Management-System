<Window x:Class="OSA_File_Management_System.View.MonitoringView.ViewMonitoringDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OSA_File_Management_System.View.MonitoringView"
        Title="Submission Details" Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Document Type:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="1" Text="{Binding DocumentType}" Margin="0,0,0,15" FontSize="14"/>

        <TextBlock Grid.Row="2" Text="Municipality:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="3" Text="{Binding Municipality}" Margin="0,0,0,15" FontSize="14"/>

        <TextBlock Grid.Row="4" Text="Barangay:" FontWeight="Bold" Margin="0,0,0,5" x:Name="BarangayLabel" 
                   Visibility="{Binding HasBarangay, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <TextBlock Grid.Row="5" Text="{Binding Barangay}" Margin="0,0,0,15" FontSize="14"
                   Visibility="{Binding HasBarangay, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <TextBlock Grid.Row="6" Text="Year:" FontWeight="Bold" Margin="0,0,0,5" x:Name="YearLabel"/>
        <TextBlock Grid.Row="7" Text="{Binding Year}" Margin="0,0,0,15" FontSize="14"/>

        <ScrollViewer Grid.Row="8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Submission Status:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding Status}" Margin="0,0,0,15" FontSize="14"/>

                <TextBlock Text="Date Submitted:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding DateSubmitted, StringFormat='{}{0:yyyy-MM-dd}'}" Margin="0,0,0,15" FontSize="14"/>

                <TextBlock Text="Remarks:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding Remarks}" Margin="0,0,0,15" FontSize="14" TextWrapping="Wrap"/>

                <TextBlock Text="PDF Document Link:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="PdfLinkTextBox" Text="{Binding PdfLink}" Margin="0,0,0,10" FontSize="14" TextWrapping="Wrap" IsReadOnly="True" Background="#F0F0F0"/>
                <Button x:Name="OpenPdfButton" Content="Open PDF in Browser" Click="OpenPdf_Click" Width="150" Height="30" HorizontalAlignment="Left"
                        Background="#257180" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" Click="Close_Click" 
                    Width="100" Height="35"
                    Background="#6c757d" Foreground="White" FontWeight="Bold" BorderThickness="0">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>