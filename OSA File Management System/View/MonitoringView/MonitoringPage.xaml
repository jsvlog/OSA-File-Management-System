<UserControl x:Class="OSA_File_Management_System.View.MonitoringView.MonitoringPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignWidth="1200" d:DesignHeight="800">
    <Grid Background="#F5F7FA" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Monitoring" FontSize="24" FontWeight="Bold" Foreground="#131B2E"/>
            <TextBlock Text="Track document submission status by municipality and year" FontSize="13" Foreground="#6B7280" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Filters -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Document Type:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <ComboBox ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding SelectedDocumentType}" 
                      Width="250" Height="32" Margin="0,0,20,0" FontSize="13"/>

            <TextBlock Text="Year:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <ComboBox ItemsSource="{Binding YearList}" SelectedItem="{Binding SelectedYear}"
                      Width="100" Height="32" Margin="0,0,20,0" FontSize="13"/>

            <Button Content="Load Data" Command="{Binding LoadMonitoringDataCommand}"
                    Width="100" Height="32" Background="#257180" Foreground="White" FontWeight="Bold" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Add Entry" Command="{Binding ShowAddForm}" Margin="10,0,0,0"
                    Width="100" Height="32" Background="#28a745" Foreground="White" FontWeight="Bold" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <!-- Data Grid -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
            <DataGrid ItemsSource="{Binding MonitoringList}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      AlternatingRowBackground="#F9FAFB"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Municipality" Binding="{Binding Municipality}" Width="2*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1*"/>
                    <DataGridTextColumn Header="Date Submitted" Binding="{Binding DateSubmitted, StringFormat='MM/dd/yyyy'}" Width="1.2*"/>
                    <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="2*"/>
                    <DataGridTemplateColumn Header="Actions" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Edit" Command="{Binding DataContext.ShowEditForm, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}" Margin="0,0,5,0"
                                            Background="#257180" Foreground="White" BorderThickness="0" 
                                            Padding="12,4" FontSize="11" FontWeight="Bold" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="Delete" Command="{Binding DataContext.DeleteMonitoring, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}"
                                            Background="#dc3545" Foreground="White" BorderThickness="0" 
                                            Padding="12,4" FontSize="11" FontWeight="Bold" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>