<UserControl x:Class="OSA_File_Management_System.View.MonitoringView.MonitoringPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:OSA_File_Management_System.View.MonitoringView"
      mc:Ignorable="d"
      d:DesignWidth="1200" d:DesignHeight="800">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Background="#F5F7FA" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="FS/AAR/AOM Monitoring" FontSize="24" FontWeight="Bold" Foreground="#131B2E"/>
            <TextBlock Text="Track document submission status by municipality and year" FontSize="13" Foreground="#6B7280" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Document Type Toggle Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="FS" Tag="Financial Statement" Width="70" Height="32" Margin="0,0,5,0"
                    Click="DocumentTypeButton_Click" FontWeight="Bold" FontSize="12"
                    Background="#257180" Foreground="White" BorderThickness="0">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
            </Button>
            <Button Content="Brgy. FS" Tag="Barangay Financial Statement" Width="80" Height="32" Margin="0,0,5,0"
                    Click="DocumentTypeButton_Click" FontWeight="Bold" FontSize="12"
                    Background="#6c757d" Foreground="White" BorderThickness="0">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
            </Button>
            <Button Content="AOM" Tag="AOM" Width="70" Height="32" Margin="0,0,5,0"
                    Click="DocumentTypeButton_Click" FontWeight="Bold" FontSize="12"
                    Background="#6c757d" Foreground="White" BorderThickness="0">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
            </Button>
            <Button Content="Brgy. AOM" Tag="Barangay AOM" Width="90" Height="32" Margin="0,0,5,0"
                    Click="DocumentTypeButton_Click" FontWeight="Bold" FontSize="12"
                    Background="#6c757d" Foreground="White" BorderThickness="0">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
            </Button>
            <Button Content="AAR" Tag="AAR" Width="70" Height="32" Margin="0,0,5,0"
                    Click="DocumentTypeButton_Click" FontWeight="Bold" FontSize="12"
                    Background="#6c757d" Foreground="White" BorderThickness="0">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
            </Button>
            <Button Content="Brgy. AAR" Tag="Barangay AAR" Width="90" Height="32" Margin="0,0,5,0"
                    Click="DocumentTypeButton_Click" FontWeight="Bold" FontSize="12"
                    Background="#6c757d" Foreground="White" BorderThickness="0">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
            </Button>

            <Rectangle Width="20"/>
            
            <Button Content="+ Add Entry" Command="{Binding ShowAddForm}"
                    Width="100" Height="32" Background="#28a745" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="12">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
            </Button>
        </StackPanel>

        <!-- Filter for Barangay Monitoring -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10"
                    Visibility="{Binding IsBarangayDocumentType, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Filter by Municipality:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
            <ComboBox Width="200" Height="30" ItemsSource="{Binding MunicipalityList}" 
                      SelectedItem="{Binding SelectedFilterMunicipality}" FontSize="13"/>
        </StackPanel>

        <!-- Data Grid for Municipality-based types (FS, AOM, AAR) -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1"
                Visibility="{Binding IsBarangayDocumentType, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <DataGrid x:Name="MonitoringGrid" ItemsSource="{Binding GridData}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      AlternatingRowBackground="#F9FAFB"
                      HeadersVisibility="All"
                      GridLinesVisibility="All"
                      BorderThickness="0"
                      FontSize="12"
                      RowHeaderWidth="0"
                      FrozenColumnCount="1"
                      ScrollViewer.CanContentScroll="False">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="View Details" Click="ContextMenu_ViewDetails"/>
                        <MenuItem Header="Edit" Click="ContextMenu_Edit"/>
                        <MenuItem Header="Delete" Click="ContextMenu_Delete"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>

        <!-- Data Grid for Barangay-based types (Barangay FS, Barangay AOM, Barangay AAR) -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1"
                Visibility="{Binding IsBarangayDocumentType, Converter={StaticResource BoolToVisibilityConverter}}">
            <DataGrid x:Name="BarangayMonitoringGrid" ItemsSource="{Binding FilteredBarangayGridData}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      AlternatingRowBackground="#F9FAFB"
                      HeadersVisibility="All"
                      GridLinesVisibility="All"
                      BorderThickness="0"
                      FontSize="12"
                      RowHeaderWidth="0"
                      FrozenColumnCount="2"
                      ScrollViewer.CanContentScroll="False">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="View Details" Click="ContextMenu_ViewDetails"/>
                        <MenuItem Header="Edit" Click="ContextMenu_Edit"/>
                        <MenuItem Header="Delete" Click="ContextMenu_Delete"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>

        <!-- Legends -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
            <Border Background="#F3F4F6" CornerRadius="4" Padding="8,4" Margin="5,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✗" FontSize="14" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="Not Submitted" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="#BBF7D0" CornerRadius="4" Padding="8,4" Margin="5,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" FontSize="14" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="Submitted" FontSize="11" Foreground="#16A34A" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>