<Window x:Class="OSA_File_Management_System.View.MonitoringView.EditMonitoringForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Monitoring Entry" Height="450" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Municipality:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" Text="{Binding EditFormData.Municipality, Mode=OneWay}" IsReadOnly="True" 
                 Margin="0,0,0,15" Height="30" FontSize="14" Background="#F0F0F0"/>

        <TextBlock Grid.Row="2" Text="Date Submitted:" FontWeight="Bold" Margin="0,0,0,5"/>
        <DatePicker Grid.Row="3" SelectedDate="{Binding EditFormData.DateSubmitted}" Margin="0,0,0,15" Height="30"/>

        <TextBlock Grid.Row="4" Text="Status:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="5" x:Name="StatusComboBox" Margin="0,0,0,15" Height="30" FontSize="14"
                  SelectedItem="{Binding EditFormStatus}">
            <ComboBoxItem Content="Pending"/>
            <ComboBoxItem Content="Submitted"/>
            <ComboBoxItem Content="Not Submitted"/>
        </ComboBox>

        <TextBlock Grid.Row="6" Text="Remarks:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="7" Text="{Binding EditFormData.Remarks}" Margin="0,0,0,15" 
                 Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Command="{Binding UpdateMonitoring}" 
                    Width="100" Height="35" Margin="0,0,10,0"
                    Background="#257180" Foreground="White" FontWeight="Bold" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Cancel" Command="{Binding CloseEditForm}" 
                    Width="100" Height="35"
                    Background="#6c757d" Foreground="White" FontWeight="Bold" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>